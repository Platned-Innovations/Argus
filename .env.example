# Copy to .env and adjust. Full reference: docs/configuration.md

# --- Required ---------------------------------------------------------------
# postgres | mongodb
ARGUS_DB_TYPE=postgres
ARGUS_DB_URL=postgres://argus:argus@localhost:5432/argus
# Root key for all encryption at rest and token signing. Generate with: openssl rand -base64 48
# Keep it secret and backed up: losing it makes stored credentials unrecoverable.
ARGUS_MASTER_KEY=

# --- Optional ---------------------------------------------------------------
# MongoDB database name (defaults to the one in the URL, then "argus")
# ARGUS_DB_NAME=argus
# Initial password for the default "admin" account on a new database. If unset, one is generated and logged once.
# ARGUS_ADMIN_PASSWORD=
# External URL users browse to. https:// enables Secure cookies and HSTS.
ARGUS_PUBLIC_URL=http://localhost:8080
# all | api | worker
ARGUS_ROLE=all
# LOG_LEVEL=info
# PORT=8080
# ARGUS_AUTH_RATE_LIMIT=10

# --- docker compose only ----------------------------------------------------
# POSTGRES_PASSWORD=argus-change-me
# MONGO_PASSWORD=argus-change-me
# ARGUS_HTTP_PORT=8080
