# Copy to .env and adjust. Full reference: docs/configuration.md

# --- Required ---------------------------------------------------------------
# postgres | mongodb
ARGUS_DB_TYPE=postgres
ARGUS_DB_URL=postgres://argus:argus@localhost:5432/argus
# Root key for all encryption at rest and token signing. Generate with: openssl rand -base64 48
# Keep it secret and backed up: losing it makes stored credentials unrecoverable.
ARGUS_MASTER_KEY=

# --- Optional ---------------------------------------------------------------
# MongoDB database name (defaults to the one in the URL, then "argus")
# ARGUS_DB_NAME=argus
# Initial password for the default "admin" account on a new database. If unset, one is generated and logged once.
# ARGUS_ADMIN_PASSWORD=
# External URL users browse to. https:// enables Secure cookies and HSTS.
ARGUS_PUBLIC_URL=http://localhost:8080
# all | api | worker
ARGUS_ROLE=all
# LOG_LEVEL=info
# PORT=8080
# Per-IP requests/minute on login, MFA and password endpoints (raise behind a shared corporate NAT)
# ARGUS_AUTH_RATE_LIMIT=10

# --- Scanning & background jobs --------------------------------------------
# Concurrent jobs (scans, source syncs) per worker process
# ARGUS_WORKER_CONCURRENCY=2
# Parent directory for temporary clones; each scan's folder is deleted when it ends
# ARGUS_SCAN_WORKDIR=/tmp/argus-scans
# Maximum time a git clone may take
# ARGUS_SCAN_TIMEOUT_MINUTES=30
# How often the scheduler looks for due scans and stale sources
# ARGUS_SCHEDULER_INTERVAL_SECONDS=30
# true = no outbound vulnerability/lifecycle lookups (air-gapped networks); secrets and certificate scans still run
# ARGUS_OFFLINE=false
# Internal mirrors for threat-intelligence sources (defaults are the public services)
# ARGUS_OSV_URL=https://api.osv.dev
# ARGUS_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# ARGUS_EPSS_URL=https://api.first.org/data/v1/epss
# ARGUS_EOL_URL=https://endoflife.date
# ARGUS_NPM_REGISTRY_URL=https://registry.npmjs.org
# ARGUS_NUGET_URL=https://api.nuget.org/v3-flatcontainer
# Microsoft sovereign clouds (e.g. GCC High): Graph and Entra ID endpoints used for email
# ARGUS_GRAPH_URL=https://graph.microsoft.com
# ARGUS_ENTRA_LOGIN_URL=https://login.microsoftonline.com
# Gitleaks binary for the secrets scanner (bundled in the Docker image; built-in rules are used if it is missing)
# ARGUS_GITLEAKS_PATH=gitleaks

# --- Corporate network (optional) ------------------------------------------
# Outbound proxy for GitHub/Bitbucket. git uses it directly; NODE_USE_ENV_PROXY=1 makes API calls use it too.
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1
# NODE_USE_ENV_PROXY=1
# Private CA bundle for self-hosted GitHub Enterprise / Bitbucket Data Center (path inside the container)
# NODE_EXTRA_CA_CERTS=/certs/corp-ca.pem
# GIT_SSL_CAINFO=/certs/corp-ca.pem

# --- docker compose only ----------------------------------------------------
# POSTGRES_PASSWORD=argus-change-me
# MONGO_PASSWORD=argus-change-me
# ARGUS_HTTP_PORT=8080
